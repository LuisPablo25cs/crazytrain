{
  "title": "Rails map",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "width": {
      "default": 1000,
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cities": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "geo": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            },
            "required": [
              "lat",
              "lon"
            ]
          },
          "country": {
            "type": "string"
          },
          "major": {
            "default": false,
            "type": "boolean"
          },
          "hazards": {
            "type": "object",
            "properties": {
              "earthquake": {
                "type": "string",
                "enum": [
                  "high",
                  "medium"
                ]
              },
              "volcano": {
                "type": "string",
                "enum": [
                  "high",
                  "medium"
                ]
              },
              "tsunami": {
                "type": "string",
                "enum": [
                  "high",
                  "medium"
                ]
              },
              "hurricane": {
                "type": "string",
                "enum": [
                  "high",
                  "medium"
                ]
              },
              "tornado": {
                "type": "string",
                "enum": [
                  "high",
                  "medium"
                ]
              },
              "snow": {
                "type": "string",
                "enum": [
                  "high",
                  "medium"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "x",
          "y"
        ]
      }
    },
    "routes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "color": {
            "type": "string",
            "enum": [
              "red",
              "orange",
              "yellow",
              "green",
              "blue",
              "purple",
              "black",
              "white",
              "gray"
            ]
          },
          "kind": {
            "default": "normal",
            "type": "string",
            "enum": [
              "normal",
              "tunnel",
              "ferry"
            ]
          },
          "ferryLocomotives": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "parallelGroup": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "angle": {
                  "type": "number"
                },
                "length": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "x",
                "y",
                "angle"
              ]
            }
          },
          "bend": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "length",
          "color"
        ]
      }
    },
    "tickets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "deck": {
            "default": "regular",
            "type": "string",
            "enum": [
              "regular",
              "long"
            ]
          },
          "via": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "points"
        ]
      }
    },
    "terrain": {
      "default": {
        "land": [],
        "lakes": []
      },
      "type": "object",
      "properties": {
        "land": {
          "default": [],
          "type": "array",
          "items": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "lakes": {
          "default": [],
          "type": "array",
          "items": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^(\\/maps\\/(?:[\\w-]+(?:\\.[\\w-]+)*\\/)*[\\w-]+(?:\\.[\\w-]+)*\\.(png|jpe?g|webp)|data:image\\/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+)$"
            },
            "x": {
              "default": 0,
              "type": "number"
            },
            "y": {
              "default": 0,
              "type": "number"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "surround": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "src",
            "width",
            "height"
          ]
        }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "players": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "playerColors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trainsPerPlayer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stationsPerPlayer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stationValue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stationCosts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "deck": {
          "type": "object",
          "properties": {
            "perColor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "locomotives": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "startingHand": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "market": {
          "type": "object",
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxLocomotives": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxResets": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "tickets": {
          "type": "object",
          "properties": {
            "initialRegular": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "initialLong": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "initialKeepMin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "drawCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "drawKeepMin": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "routeScoring": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "longestTrailBonus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastRoundTrainThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parallelLanes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "minPlayers": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "lanes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "minPlayers",
              "lanes"
            ]
          }
        },
        "tunnelRevealCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expansions": {
          "type": "object",
          "properties": {
            "tunnels": {
              "type": "boolean"
            },
            "ferries": {
              "type": "boolean"
            },
            "stations": {
              "type": "boolean"
            },
            "longTickets": {
              "type": "boolean"
            }
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "classic",
            "seasons"
          ]
        },
        "seasons": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      }
    },
    "display": {
      "type": "object",
      "properties": {
        "slotWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "laneSpacing": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "edited": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "height",
    "cities",
    "routes",
    "tickets"
  ]
}
