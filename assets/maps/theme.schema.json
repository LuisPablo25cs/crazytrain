{
  "title": "Rails theme",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "cardColors": {
      "type": "object",
      "properties": {
        "red": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "orange": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "yellow": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "green": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "blue": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "purple": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "black": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "white": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "locomotive": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "gray": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple",
        "black",
        "white",
        "locomotive",
        "gray"
      ]
    },
    "playerColors": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "terrain": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "water": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "land": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "landVariation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lake": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "imageTint": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "background",
        "water",
        "land",
        "landVariation",
        "lake"
      ]
    },
    "board": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "majorCity": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "label": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "labelOutline": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "highlight": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "blocked": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "city",
        "majorCity",
        "label",
        "labelOutline",
        "highlight",
        "blocked"
      ]
    },
    "ui": {
      "type": "object",
      "properties": {
        "panel": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "panelText": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "panel",
        "panelText",
        "accent",
        "muted"
      ]
    },
    "lighting": {
      "type": "object",
      "properties": {
        "ambient": {
          "type": "number",
          "minimum": 0
        },
        "sun": {
          "type": "number",
          "minimum": 0
        },
        "sunColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "ambient",
        "sun",
        "sunColor"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "cardColors",
    "playerColors",
    "terrain",
    "board",
    "ui",
    "lighting"
  ]
}
